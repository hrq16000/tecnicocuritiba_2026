{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/assistencia-tecnica-curitiba",
        "http://localhost:4173/termos-e-condicoes",
        "http://localhost:4173/servicos",
        "http://localhost:4173/suporte-empresas",
        "http://localhost:4173/servicos/redes-wifi",
        "http://localhost:4173/servicos/backup-recuperacao"
      ],
      "startServerCommand": "bun run preview -- --port 4173",
      "startServerReadyPattern": "Local:",
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 915,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2200
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-mobile"
    }
  }
}
