{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/assistencia-tecnica-curitiba",
        "http://localhost:4173/termos-e-condicoes",
        "http://localhost:4173/servicos",
        "http://localhost:4173/suporte-empresas",
        "http://localhost:4173/servicos/redes-wifi",
        "http://localhost:4173/servicos/backup-recuperacao"
      ],
      "startServerCommand": "bun run preview -- --port 4173",
      "startServerReadyPattern": "Local:",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
